# ==========================================
# BANQUETHUB - ENVIRONMENT CONFIGURATION TEMPLATE
# Sao chép file này thành .env: Copy-Item .env.example .env
# Các giá trị dưới đây là mặc định chuẩn cho môi trường Local Dev
# ==========================================

# --- 1. PostgreSQL 17 (Docker Compose & Backend Datasource) ---
POSTGRES_DB=banquet_hub
POSTGRES_USER=banquet_user
POSTGRES_PASSWORD=BanquetHub_Local_2026!
POSTGRES_PORT=5433

# --- 2. Spring Boot Backend ---
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/banquet_hub
SPRING_DATASOURCE_USERNAME=banquet_user
SPRING_DATASOURCE_PASSWORD=BanquetHub_Local_2026!

# JWT Configuration (tối thiểu 32 ký tự cho HS256)
APP_JWT_SECRET=BanquetHub_Local_Jwt_Secret_Key_2026_For_HS256_Signing_Min32Bytes
APP_JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo Seed Accounts (khởi tạo tài khoản demo sẵn có khi chạy lần đầu)
APP_SEED_ENABLED=true
APP_SEED_ADMIN_EMAIL=admin@banquethub.vn
APP_SEED_ADMIN_PASSWORD=Admin@123
APP_SEED_EMPLOYEE_EMAIL=employee@banquethub.vn
APP_SEED_EMPLOYEE_PASSWORD=Employee@123
APP_SEED_USER_EMAIL=user@banquethub.vn
APP_SEED_USER_PASSWORD=User@123

# --- 3. React Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8080/api/v1

APP_FRONTEND_URL=http://localhost:5173
# Đặt URL frontend mà khách có thể truy cập. Nếu bỏ dòng này, dùng APP_FRONTEND_URL.
# APP_WEBSITE_URL=https://banquet.example.com
EMAIL_WORKER_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=noreply@banquethub.local
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS_ENABLE=false
MAIL_SSL=false
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
SEPAY_IPN_SECRET=
SEPAY_RETURN_URL=http://localhost:5173/payment/result
