# ==========================================
# BANQUETHUB - ENVIRONMENT CONFIGURATION EXAMPLE
# Copy file này thành .env (và infra/.env nếu cần tùy chỉnh)
# ==========================================

# --- 1. PostgreSQL 17 (Docker Compose & Backend Datasource) ---
POSTGRES_DB=banquet_hub
POSTGRES_USER=banquet_user
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_DEV_PASSWORD
POSTGRES_PORT=5432

# --- 2. Spring Boot Backend ---
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/banquet_hub
SPRING_DATASOURCE_USERNAME=banquet_user
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_LOCAL_DEV_PASSWORD

# JWT Configuration (tối thiểu 32 ký tự cho HS256)
APP_JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_32_BYTES_SECRET_KEY_FOR_HS256
APP_JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo Seed Accounts (chỉ dùng cho môi trường phát triển local)
APP_SEED_ENABLED=true
APP_SEED_ADMIN_EMAIL=admin@banquethub.vn
APP_SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_DEMO_PASSWORD
APP_SEED_EMPLOYEE_EMAIL=employee@banquethub.vn
APP_SEED_EMPLOYEE_PASSWORD=CHANGE_ME_EMPLOYEE_DEMO_PASSWORD
APP_SEED_USER_EMAIL=user@banquethub.vn
APP_SEED_USER_PASSWORD=CHANGE_ME_USER_DEMO_PASSWORD

# --- 3. React Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8080/api/v1
