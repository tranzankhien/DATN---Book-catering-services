# Ignore docs, agent configs, and plan files
/docs/
/report-weekly/
/.agents/
/implementation_plan.md
*.md

!/.gitignore
!/source_code/
!/source_code/**

# Local environment files
**/.env
**/.env.*
!**/.env.example
!**/.env.sample
!**/.env.template

# Spring environment configuration
**/application.properties
**/application.yml
**/application.yaml
**/application-*.properties
**/application-*.yml
**/application-*.yaml
!**/application-example.properties
!**/application-example.yml
!**/application-example.yaml
!**/application.example.properties
!**/application.example.yml
!**/application.example.yaml
!/source_code/backend/src/main/resources/application.properties
!/source_code/backend/src/test/resources/application.properties

# Credentials, private keys and local certificates
**/*secret*
**/*credential*
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*.jks
